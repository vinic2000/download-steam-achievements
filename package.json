{
  "name": "download-steam-achievements",
  "version": "1.0.1",
  "description": "",
  "main": "index.ts",
  "bin": "dist/index.js",
  "pkg": {
    "assets": [],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-macos-arm64"
    ],
    "outputPath": "build"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
  "bundle": "npx @vercel/ncc build bundle-entry.js -o dist-bundle",
    "start": "node dist/index.js",
    "pkg:mac": "pkg dist-bundle/index.js --targets node18-macos-x64,node18-macos-arm64 --output build/download-steam-achievements-macos",
    "pkg:win": "pkg dist-bundle/index.js --targets node18-win-x64 --output build/download-steam-achievements-win.exe",
    "pkg:all": "pnpm run build && pnpm run bundle && pnpm run pkg:mac && pnpm run pkg:win"
  },
  "keywords": [],
  "author": "Vinicius Lino",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "nodemon": "^3.1.10",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
  "@vercel/ncc": "^0.38.4"
  }
}